# Optional local server settings.
ATOMS_ADDR=:8080
ATOMS_DATA_DIR=./data
ATOMS_MODEL_TIMEOUT=120s

# Optional shared defaults. Browser settings override these safely per request.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# Set true only in a trusted environment when users need localhost/private model endpoints.
ATOMS_ALLOW_PRIVATE_MODEL_ENDPOINTS=false
